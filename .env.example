# ─── Database ───────────────────────────────────────────────────────────
# DO teen URLs ka matlab samajh lo — yeh galat karne par migrations randomly
# hang hoti hain:
#
#   DATABASE_URL        → POOLED endpoint. App runtime isse use karta hai.
#                         Neon ka pooler (PgBouncer) hazaaron short-lived
#                         connections handle karta hai.
#   DIRECT_DATABASE_URL → DIRECT endpoint (hostname se "-pooler" hata do).
#                         Prisma Migrate SIRF isse use karta hai, kyunki
#                         migrations Postgres advisory locks lete hain aur
#                         PgBouncer transaction mode mein woh kaam nahi karte.
#
# Local Docker par dono same rehte hain (koi pooler hi nahi hota).

# Neon (cloud):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
#   DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Local Docker (pnpm db:up):
DATABASE_URL="postgresql://nearbux:devpassword@localhost:5432/nearbux?schema=public"
DIRECT_DATABASE_URL="postgresql://nearbux:devpassword@localhost:5432/nearbux?schema=public"

# Integration tests isse use karte hain. LOCAL rakho — tests users banate aur
# delete karte hain, isliye ye kabhi shared/cloud database par point nahi
# karna chahiye. `pnpm db:up` se local Postgres chalu hota hai.
TEST_DATABASE_URL="postgresql://nearbux:devpassword@localhost:5432/nearbux?schema=public"

# Ek API instance kitne Postgres connections kholega.
# Neon pooler ke peeche 5 rakho — serverless instances multiply hote hain.
DATABASE_POOL_MAX=5

# ─── API ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"

# ─── Auth ───────────────────────────────────────────────────────────────
# Production mein secret manager se aayega, git mein kabhi nahi
JWT_ACCESS_SECRET="dev-only-change-me-min-32-chars-long-xxxx"
JWT_REFRESH_SECRET="dev-only-change-me-too-min-32-chars-yyyy"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ─── Payments (Razorpay) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ─── Client (Expo) ──────────────────────────────────────────────────────
# WARNING: EXPO_PUBLIC_* bundle mein inline hota hai aur har user ke device
# par ship hota hai. Yahan kabhi koi secret mat daalna.
EXPO_PUBLIC_API_URL="http://localhost:3000"
