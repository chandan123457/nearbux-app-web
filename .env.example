# ─── Database ───────────────────────────────────────────────────────────
# DO teen URLs ka matlab samajh lo — yeh galat karne par migrations randomly
# hang hoti hain:
#
#   DATABASE_URL        → POOLED endpoint. App runtime isse use karta hai.
#                         Neon ka pooler (PgBouncer) hazaaron short-lived
#                         connections handle karta hai.
#   DIRECT_DATABASE_URL → DIRECT endpoint (hostname se "-pooler" hata do).
#                         Prisma Migrate SIRF isse use karta hai, kyunki
#                         migrations Postgres advisory locks lete hain aur
#                         PgBouncer transaction mode mein woh kaam nahi karte.
#
# Local Docker par dono same rehte hain (koi pooler hi nahi hota).

# Neon (cloud):
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
#   DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
#
# Local Docker (pnpm db:up):
DATABASE_URL="postgresql://nearbux:devpassword@localhost:5432/nearbux?schema=public"
DIRECT_DATABASE_URL="postgresql://nearbux:devpassword@localhost:5432/nearbux?schema=public"

# Integration tests isse use karte hain. LOCAL rakho — tests users banate aur
# delete karte hain, isliye ye kabhi shared/cloud database par point nahi
# karna chahiye. `pnpm db:up` se local Postgres chalu hota hai.
TEST_DATABASE_URL="postgresql://nearbux:devpassword@localhost:5432/nearbux?schema=public"

# Ek API instance kitne Postgres connections kholega.
# Neon pooler ke peeche 5 rakho — serverless instances multiply hote hain.
DATABASE_POOL_MAX=5

# ─── API ────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
API_BASE_URL="http://localhost:3000"

# ─── Auth ───────────────────────────────────────────────────────────────
# Production mein secret manager se aayega, git mein kabhi nahi
JWT_ACCESS_SECRET="dev-only-change-me-min-32-chars-long-xxxx"
JWT_REFRESH_SECRET="dev-only-change-me-too-min-32-chars-yyyy"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ─── Firebase Phone Auth ────────────────────────────────────────────────
# OTP hum na banate hain na bhejte hain — Firebase karta hai. Client se
# server ko ek signed ID token milta hai, jise firebase-admin verify karke
# usmein se phone number nikaalta hai.
#
# In dono ko alag-alag rakhna ZAROORI hai:
#
#   FIREBASE_*         → SERVICE ACCOUNT. Yeh SECRET hai. Firebase Console →
#                        Project settings → Service accounts → "Generate new
#                        private key" se ek JSON milti hai; usmein se teen
#                        values yahan aati hain. Yeh sirf server par rehti
#                        hain aur kabhi bundle mein nahi jaati.
#
#   EXPO_PUBLIC_*      → WEB APP CONFIG. Yeh PUBLIC hai (Firebase ise secret
#                        maanta hi nahi — asli protection Auth rules aur App
#                        Check se aati hai). Firebase Console → Project
#                        settings → General → "Your apps" se milti hai.
#
# Private key mein newlines hoti hain. Use ek hi line mein, quotes ke andar,
# literal 
 ke saath rakho — server load karte waqt unhe wapas newline bana
# leta hai.
#
# Firebase Console mein Authentication → Sign-in method → **Phone** enable
# karna mat bhoolna, aur web ke liye Authentication → Settings → Authorized
# domains mein apna domain (aur localhost) add karna.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Yeh teeno khaali chhodne par development mein OTP SKIP ho jaata hai: koi SMS
# nahi jaata aur koi bhi 6-digit code chal jaata hai. Production mein server
# inke bina boot hi nahi hota.

# ─── Payments (Razorpay) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ─── Client (Expo) ──────────────────────────────────────────────────────
# WARNING: EXPO_PUBLIC_* bundle mein inline hota hai aur har user ke device
# par ship hota hai. Yahan kabhi koi secret mat daalna.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Firebase web app config — upar wale service account se ALAG hai.
# Public values; phone OTP ke liye client SDK inhe use karta hai.
EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID="
