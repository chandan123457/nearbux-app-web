{
  "name": "@nearbux/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nearbux/core": "workspace:*",
    "@nearbux/database": "workspace:*",
    "@nearbux/types": "workspace:*",
    "@nearbux/validation": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nearbux/config": "workspace:*",
    "@types/node": "^24.10.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
