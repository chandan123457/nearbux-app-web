{
  "name": "nearbux",
  "private": true,
  "version": "0.1.0",
  "description": "NearBux \u2014 hyperlocal multi-store delivery marketplace (web + iOS + Android)",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @nearbux/database run generate",
    "db:migrate": "pnpm --filter @nearbux/database run migrate",
    "db:deploy": "pnpm --filter @nearbux/database run migrate:deploy",
    "db:seed": "pnpm --filter @nearbux/database run seed",
    "db:reset": "pnpm --filter @nearbux/database run reset",
    "db:studio": "pnpm --filter @nearbux/database run studio",
    "typecheck": "pnpm -r --no-bail typecheck",
    "build": "pnpm --filter \"@nearbux/api...\" run build",
    "test": "pnpm -r --no-bail test",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo && rm -rf node_modules",
    "dev": "pnpm --filter @nearbux/api run dev"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
