{
  "name": "@nearbux/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "reset": "prisma migrate reset --force",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nearbux/core": "workspace:*",
    "@nearbux/types": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "~7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@nearbux/config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "~7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
